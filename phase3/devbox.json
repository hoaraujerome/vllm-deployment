{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "pre-commit@4.5.1",
    "git@2.54.0",
    "awscli2@2.34.24",
    "jq@1.8.2",
    "trivy@0.72.0",
    "terraform@1.15.3",
    "kubectl@1.36.0",
    "wireguard-tools@1.0.20210914"
  ],
  "shell": {
    "init_hook": [
      "echo 'phase3 devbox — terraform, wireguard, kubectl, awscli' > /dev/null"
    ],
    "scripts": {
      "check": [
        "make check"
      ],
      "check-gates": [
        "make check-gates"
      ],
      "check-toolchain": [
        "make check-toolchain"
      ]
    }
  }
}
