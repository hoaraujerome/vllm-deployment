{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "pre-commit@4.5.1",
    "git@2.54.0",
    "awscli2@2.34.24",
    "jq@1.8.2",
    "trivy@0.72.0",
    "packer@1.15.3",
    "ansible@2.21.1",
    "terraform@1.15.3",
    "ansible-lint@25.8.2"
  ],
  "shell": {
    "init_hook": [
      "echo 'phase2 devbox — terraform, packer, ansible, awscli' > /dev/null"
    ],
    "scripts": {
      "check": [
        "./scripts/phase2-check.sh"
      ]
    }
  }
}
